# eCourts Order Date Search - Environment Variables

# Official eCourts portal URL
ECOURTS_BASE_URL=https://services.ecourts.gov.in/ecourtindia_v6/?p=courtorder%2Findex

# Browser & session settings
SESSION_TIMEOUT_SECONDS=300
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
MAX_CONCURRENT_SESSIONS=10

# Mock Mode (set to true for offline demonstrations/testing)
ECOURTS_MOCK_MODE=false

# Server configuration
HOST=127.0.0.1
PORT=8000
